PORT=5000
APP_NAME=HustleHub API
NODE_ENV=development

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/hustlehub?retryWrites=true&w=majority
JWT_SECRET=change-me-use-32-plus-characters-in-production

JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
CLIENT_ORIGIN=http://127.0.0.1:5173
SSL_KEY_PATH=certificates/privatekey.pem
SSL_CERT_PATH=certificates/certificate.pem

# Monitoring and account lockout (optional, defaults shown)
LOG_DIR=logs
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
AUDIT_RETENTION_DAYS=90


