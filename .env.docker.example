# Copy to ".env" in the repository root (same folder as docker-compose.yml). Never commit the real file.
MONGO_ROOT_USER=hustlehub_root
MONGO_ROOT_PASSWORD=change-me-root-password
APP_DB_USER=hustlehub_app
APP_DB_PASSWORD=change-me-app-password
# At least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters
# Where the browser reaches the app (must match exactly, including http/https and port)
CLIENT_ORIGIN=http://localhost:8080
VITE_API_URL=https://localhost:5000/api
API_ORIGIN=https://localhost:5000
